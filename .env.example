# Shopify app client secret — used to verify the X-Shopify-Hmac-Sha256 header.
# Found in your custom app's "Client credentials" page.
SHOPIFY_WEBHOOK_SECRET=

# e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Merchant Center account ID (numeric)
GOOGLE_MERCHANT_ACCOUNT_ID=

# The Merchant API data source products are written to
# (format: accounts/{account}/dataSources/{dataSource})
GOOGLE_DATA_SOURCE=

# Path to a service-account JSON key file with Merchant API access
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: JSON map of Shopify location ID -> Business Profile location ID
# e.g. {"65581383": "locations/12345678901234567890"}
GBP_LOCATION_MAP=

PORT=3000
